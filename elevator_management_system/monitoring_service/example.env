# monitoring_service Environment Variables

# Service Configuration
SERVICE_NAME=monitoring_service
SERVICE_PORT=8005
SERVICE_HOST=0.0.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/monitoring_service_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=elevator-org
INFLUXDB_BUCKET=elevator-metrics
