# gateway Environment Variables

# Service Configuration
SERVICE_NAME=gateway
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/gateway_db
