# elevator_service Environment Variables

# Service Configuration
SERVICE_NAME=elevator_service
SERVICE_PORT=8003
SERVICE_HOST=0.0.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/elevator_service_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=elevator_logs
